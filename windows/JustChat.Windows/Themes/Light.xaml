<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F4F5F7" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#FAFBFC" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#1D2129" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#69707D" />
    <SolidColorBrush x:Key="BorderBrush" Color="#DEE2E8" />
    <SolidColorBrush x:Key="ButtonBackgroundBrush" Color="#ECEFF3" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D8DDE5" />
    <SolidColorBrush x:Key="AccentBrush" Color="#3157C8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SubtleAccentBrush" Color="#E9EEFC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#237957" />
    <SolidColorBrush x:Key="WarningBrush" Color="#96601B" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#BD4048" />
</ResourceDictionary>
