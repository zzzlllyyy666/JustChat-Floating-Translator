<Window x:Class="JustChat.Windows.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="默认翻译习惯"
        Width="420"
        Height="400"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock FontSize="21" FontWeight="SemiBold" Text="默认翻译习惯" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,5,0,0"
                       Text="用自己的话描述，不需要选择分类" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="你所在的行业" />
            <TextBox x:Name="IndustryTextBox"
                     Height="38"
                     Margin="0,7,0,0"
                     MaxLength="160"
                     VerticalContentAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,6,0,0"
                       Text="例如：跨境电商、建筑设计、SaaS 销售" />
        </StackPanel>

        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="你希望的语气" />
            <TextBox x:Name="ToneTextBox"
                     Height="38"
                     Margin="0,7,0,0"
                     MaxLength="160"
                     VerticalContentAlignment="Center" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}"
                       Margin="0,6,0,0"
                       Text="例如：自然、专业，不要太客套" />
        </StackPanel>

        <TextBlock x:Name="PreferencesStatusTextBlock"
                   Grid.Row="3"
                   Style="{StaticResource SecondaryTextStyle}"
                   Margin="0,12,0,0"
                   TextWrapping="Wrap"
                   Text="每项最多 160 个字符；留空则不设置" />

        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Button Content="清除默认"
                    Style="{StaticResource QuietButtonStyle}"
                    HorizontalAlignment="Left"
                    Click="ClearButton_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="74"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="设为默认"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="92"
                        IsDefault="True"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
