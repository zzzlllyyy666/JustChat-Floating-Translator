<Window x:Class="JustChat.Windows.PreferencesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="默认翻译习惯"
        Width="400"
        Height="350"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#F5F5F7"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="默认翻译习惯"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="#1D1D1F" />
            <TextBlock Text="直接用自己的话描述，不需要选择分类"
                       Margin="0,4,0,0"
                       FontSize="11"
                       Foreground="#6E6E73" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="你所在的行业"
                       Margin="0,0,0,5"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#3A3A3C" />
            <TextBox x:Name="IndustryTextBox"
                     Height="32"
                     Padding="8,4"
                     MaxLength="160"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#D8D8DC" />
            <TextBlock Text="例如：跨境电商、建筑设计、SaaS 销售"
                       Margin="0,5,0,0"
                       FontSize="10"
                       Foreground="#8E8E93"
                       TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,10">
            <TextBlock Text="你希望的语气"
                       Margin="0,0,0,5"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#3A3A3C" />
            <TextBox x:Name="ToneTextBox"
                     Height="32"
                     Padding="8,4"
                     MaxLength="160"
                     VerticalContentAlignment="Center"
                     Background="White"
                     BorderBrush="#D8D8DC" />
            <TextBlock Text="例如：自然、专业，不要太客套"
                       Margin="0,5,0,0"
                       FontSize="10"
                       Foreground="#8E8E93"
                       TextWrapping="Wrap" />
        </StackPanel>

        <TextBlock x:Name="PreferencesStatusTextBlock"
                   Grid.Row="3"
                   FontSize="10"
                   Foreground="#8E8E93"
                   TextWrapping="Wrap"
                   Text="每项最多 160 个字符；留空则不设置" />

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Button Content="清除默认"
                    Padding="10,5"
                    HorizontalAlignment="Left"
                    Click="ClearButton_Click" />
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="取消"
                        Width="70"
                        Margin="0,0,8,0"
                        IsCancel="True" />
                <Button Content="设为默认"
                        Width="86"
                        IsDefault="True"
                        FontWeight="SemiBold"
                        Click="SaveButton_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
