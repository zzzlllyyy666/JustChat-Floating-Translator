<Window x:Class="JustChat.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JustChat"
        Width="360"
        Height="420"
        MinWidth="340"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        Topmost="True"
        Background="#F5F5F7"
        FontFamily="Microsoft YaHei UI, Segoe UI">
    <Grid Margin="18,16,18,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="JustChat"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#1D1D1F" />
            <TextBlock Text="写下中文，准备好再翻译"
                       Margin="0,3,0,0"
                       FontSize="12"
                       Foreground="#6E6E73" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="目标语言"
                       Margin="0,0,0,5"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#3A3A3C" />
            <ComboBox x:Name="TargetLanguageSelector"
                      Height="32"
                      Padding="8,3"
                      DisplayMemberPath="MenuLabel"
                      VerticalContentAlignment="Center" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="中文草稿"
                       Margin="0,0,0,5"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#3A3A3C" />
            <TextBox x:Name="DraftTextBox"
                     Grid.Row="1"
                     MinHeight="62"
                     Padding="9,7"
                     AcceptsReturn="True"
                     AcceptsTab="False"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Background="White"
                     BorderBrush="#D8D8DC"
                     CaretBrush="#1D1D1F" />
        </Grid>

        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="译文"
                       Margin="0,0,0,5"
                       FontSize="12"
                       FontWeight="SemiBold"
                       Foreground="#3A3A3C" />
            <TextBox x:Name="TranslationTextBox"
                     Grid.Row="1"
                     MinHeight="62"
                     Padding="9,7"
                     IsReadOnly="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"
                     Background="#EDEDF0"
                     BorderBrush="#D8D8DC" />
        </Grid>

        <Button Grid.Row="4"
                Height="34"
                Content="翻译功能待接入"
                IsEnabled="False"
                FontWeight="SemiBold" />

        <TextBlock Grid.Row="5"
                   Margin="0,8,0,0"
                   HorizontalAlignment="Center"
                   FontSize="11"
                   Foreground="#8E8E93"
                   Text="Windows 基础界面预览 · 当前不会发送文本" />
    </Grid>
</Window>
